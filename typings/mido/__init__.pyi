# type information for the parts of mido used by this project, mido doesn't ship any

from collections.abc import Iterable
from pathlib import Path
from typing import Any

class Message:
    type: str
    time: int
    def __init__(self, type: str, *, time: int = 0, **fields: Any) -> None: ...
    def dict(self) -> dict[str, Any]: ...

class MetaMessage(Message): ...

class MidiTrack(list[Message]):
    name: str
    def __init__(self, messages: Iterable[Message] = ...) -> None: ...

class MidiFile:
    tracks: list[MidiTrack]
    ticks_per_beat: int
    length: float
    def __init__(self, filename: str | Path | None = None, *, ticks_per_beat: int = 480) -> None: ...
    def save(self, filename: str | Path) -> None: ...

def tick2second(tick: int, ticks_per_beat: int, tempo: int) -> float: ...
def second2tick(second: float, ticks_per_beat: int, tempo: int) -> float: ...
def bpm2tempo(bpm: float, time_signature: tuple[int, int] = (4, 4)) -> int: ...
